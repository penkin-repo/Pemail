<Window x:Class="Pemail.UI.AccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Аккаунты почты" Height="470" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgWindow}" Foreground="{DynamicResource TextPrimary}">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Подключённые ящики" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="BtnNew" Content="+ Добавить" Click="BtnNew_Click" Margin="0,0,6,0"/>
                    <Button x:Name="BtnDelete" Content="Удалить" Style="{StaticResource DangerButton}" Click="BtnDelete_Click"/>
                </StackPanel>
                <ListBox x:Name="LstAccounts" DisplayMemberPath="DisplayName" SelectionChanged="LstAccounts_SelectionChanged" BorderBrush="{DynamicResource BorderSubtle}"/>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button x:Name="BtnTest" Content="Проверить вход" Click="BtnTest_Click" Margin="0,0,6,0"/>
                    <Button x:Name="BtnSave" Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click" Margin="0,0,6,0"/>
                    <Button Content="Закрыть" Click="BtnClose_Click"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Провайдер" FontSize="11" Foreground="#6B7280"/>
                        <ComboBox x:Name="CmbProvider" SelectionChanged="CmbProvider_SelectionChanged" Margin="0,2,0,8" Height="26">
                            <ComboBoxItem Content="Gmail (imap.gmail.com / smtp.gmail.com)"/>
                            <ComboBoxItem Content="Яндекс.Почта (imap.yandex.ru / smtp.yandex.ru)"/>
                            <ComboBoxItem Content="Другой IMAP/SMTP"/>
                        </ComboBox>

                        <TextBlock Text="Отображаемое имя" FontSize="11" Foreground="#6B7280"/>
                        <TextBox x:Name="TxtDisplayName" Margin="0,2,0,8" Height="25" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Email (логин)" FontSize="11" Foreground="#6B7280"/>
                        <TextBox x:Name="TxtEmail" Margin="0,2,0,8" Height="25" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Пароль приложения (шифруется через Windows DPAPI)" FontSize="11" Foreground="#6B7280"/>
                        <PasswordBox x:Name="PwdBox" Margin="0,2,0,4" Height="25" VerticalContentAlignment="Center"/>
                        <TextBlock x:Name="TxtHint" TextWrapping="Wrap" FontSize="11" Foreground="#4B5563" Margin="0,0,0,10"
                                   Text="Для Gmail и Яндекса нужен пароль приложения (не основной пароль). Оставьте поле пустым при редактировании, чтобы не менять сохранённый пароль."/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="72"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="IMAP сервер" FontSize="11" Foreground="#6B7280"/>
                                <TextBox x:Name="TxtImapHost" Margin="0,2,0,0" Height="25" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Порт" FontSize="11" Foreground="#6B7280"/>
                                <TextBox x:Name="TxtImapPort" Margin="0,2,0,0" Height="25" VerticalContentAlignment="Center" Text="993"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="72"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SMTP сервер" FontSize="11" Foreground="#6B7280"/>
                                <TextBox x:Name="TxtSmtpHost" Margin="0,2,0,0" Height="25" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Порт" FontSize="11" Foreground="#6B7280"/>
                                <TextBox x:Name="TxtSmtpPort" Margin="0,2,0,0" Height="25" VerticalContentAlignment="Center" Text="465"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="ChkImplicitTls" Content="SMTP Implicit TLS (порт 465; снимите для STARTTLS 587)" IsChecked="True" FontSize="12" Margin="0,2,0,6"/>
                        <CheckBox x:Name="ChkMarkRead" Content="Помечать скачанные письма прочитанными на сервере" IsChecked="False" FontSize="12" Margin="0,0,0,6"/>

                        <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" FontSize="11" Foreground="#2563EB" Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
