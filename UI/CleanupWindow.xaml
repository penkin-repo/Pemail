<Window x:Class="Pemail.UI.CleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Освобождение места на сервере (предпросмотр)" Height="510" Width="670"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgWindow}" Foreground="{DynamicResource TextPrimary}">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Безопасный режим: ничего не удаляется, пока вы не нажмёте красную кнопку и не подтвердите. В список попадают ТОЛЬКО письма, чья локальная копия проверена на диске."
                           TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>

                <WrapPanel Margin="0,0,0,6">
                    <StackPanel Margin="0,0,12,4">
                        <TextBlock Text="Аккаунт" FontSize="11" Foreground="#6B7280"/>
                        <ComboBox x:Name="CmbAccount" DisplayMemberPath="DisplayName" Width="190" Height="25" SelectionChanged="FilterChanged"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,4">
                        <TextBlock Text="Старше (дней)" FontSize="11" Foreground="#6B7280"/>
                        <ComboBox x:Name="CmbAge" Width="130" Height="25" SelectionChanged="FilterChanged">
                            <ComboBoxItem Content="Любой возраст" Tag="0"/>
                            <ComboBoxItem Content="Старше 30 дней" Tag="30"/>
                            <ComboBoxItem Content="Старше 90 дней" Tag="90"/>
                            <ComboBoxItem Content="Старше 180 дней" Tag="180"/>
                            <ComboBoxItem Content="Старше 1 года" Tag="365" IsSelected="True"/>
                            <ComboBoxItem Content="Старше 2 лет" Tag="730"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,4">
                        <TextBlock Text="Размер не меньше" FontSize="11" Foreground="#6B7280"/>
                        <ComboBox x:Name="CmbSize" Width="130" Height="25" SelectionChanged="FilterChanged">
                            <ComboBoxItem Content="Любой размер" Tag="0" IsSelected="True"/>
                            <ComboBoxItem Content=">= 500 КБ" Tag="512000"/>
                            <ComboBoxItem Content=">= 1 МБ" Tag="1048576"/>
                            <ComboBoxItem Content=">= 5 МБ" Tag="5242880"/>
                            <ComboBoxItem Content=">= 10 МБ" Tag="10485760"/>
                        </ComboBox>
                    </StackPanel>
                </WrapPanel>

                <CheckBox x:Name="ChkEmptyTrash" Content="После переноса очистить Корзину на сервере (чтобы реально освободить квоту Gmail / Яндекс)"
                          IsChecked="True" FontSize="12" Margin="0,2,0,6"/>

                <TextBlock x:Name="TxtSummary" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
            </StackPanel>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <ProgressBar x:Name="PrgCleanup" DockPanel.Dock="Left" Width="260" Height="16" VerticalAlignment="Center" Visibility="Collapsed"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BtnRun" Content="Удалить выбранные с сервера" Style="{StaticResource DangerButton}" Click="BtnRun_Click" Margin="0,0,8,0"/>
                <Button Content="Закрыть" Click="BtnClose_Click"/>
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="110"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="GridCandidates" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      Background="{DynamicResource BgPanel}" RowBackground="{DynamicResource BgPanel}"
                      Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderSubtle}"
                      BorderThickness="1" FontSize="12" RowHeight="24">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Папка" Binding="{Binding FolderDisplay}" Width="110"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding DateShort}" Width="70"/>
                    <DataGridTextColumn Header="От" Binding="{Binding FromShort}" Width="140"/>
                    <DataGridTextColumn Header="Тема" Binding="{Binding Subject}" Width="*"/>
                    <DataGridTextColumn Header="Размер" Binding="{Binding SizeShort}" Width="75"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="2" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="6">
                <TextBox x:Name="TxtLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" BorderThickness="0" FontFamily="Consolas" FontSize="11"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
