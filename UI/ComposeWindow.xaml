<Window x:Class="Pemail.UI.ComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новое письмо" Height="540" Width="690"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgWindow}" Foreground="{DynamicResource TextPrimary}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="68"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="От:" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                    <ToggleButton x:Name="TglBatch" DockPanel.Dock="Right" Style="{StaticResource FilterToggle}"
                                  Content="Рассылка (список)" Margin="8,0,0,0" Height="26" Padding="9,0"
                                  Click="TglBatch_Click"
                                  ToolTip="Отправить письмо каждому адресату по очереди отдельным письмом (без общей копии и с антиспам-паузой)"/>
                    <ComboBox x:Name="CmbFrom" DisplayMemberPath="DisplayName" Height="26"/>
                </DockPanel>

                <TextBlock x:Name="LblTo" Grid.Row="1" Grid.Column="0" Text="Кому:" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                <TextBox x:Name="TxtTo" Grid.Row="1" Grid.Column="1" Height="26" VerticalContentAlignment="Center" Padding="4,0" Margin="0,0,0,6"
                         TextChanged="RecipientBox_TextChanged" PreviewKeyDown="RecipientBox_PreviewKeyDown"
                         GotKeyboardFocus="RecipientBox_GotFocus" LostKeyboardFocus="RecipientBox_LostFocus"/>

                <!-- Режим рассылки: сохранённые списки + многострочный список адресатов в столбик + антиспам-пауза -->
                <StackPanel x:Name="PanelBatchTo" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,5">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                            <Button x:Name="BtnSaveList" Content="Сохранить список" Padding="8,2" FontSize="11" Height="24"
                                    Margin="0,0,4,0" Click="BtnSaveList_Click"
                                    ToolTip="Сохранить текущий список адресов на будущее"/>
                            <Button x:Name="BtnDeleteList" Content="Удалить" Padding="7,2" FontSize="11" Height="24"
                                    Click="BtnDeleteList_Click" IsEnabled="False"
                                    ToolTip="Удалить выбранный сохранённый список"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Список:" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox x:Name="CmbSavedLists" Height="24" FontSize="11.5" DisplayMemberPath="DisplayLabel"
                                  SelectionChanged="CmbSavedLists_SelectionChanged"
                                  ToolTip="Выберите ранее сохранённый список адресатов"/>
                    </DockPanel>
                    <Grid>
                        <TextBox x:Name="TxtBatchTo" Height="106" AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Padding="6,5" FontSize="12" TextChanged="TxtBatchTo_TextChanged"/>
                        <TextBlock x:Name="TxtBatchHint" Text="Вставьте адреса в столбик (по одному на строку, можно прямо из Excel)..."
                                   IsHitTestVisible="False" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="9,6,0,0"
                                   VerticalAlignment="Top"/>
                    </Grid>
                    <DockPanel Margin="0,5,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Пауза:" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox x:Name="CmbBatchDelay" Height="23" FontSize="11" Width="168" SelectedIndex="1"
                                      ToolTip="Случайная пауза между письмами, чтобы не сработали антиспам-фильтры Яндекса и Gmail">
                                <ComboBoxItem Content="2–4 сек (быстро)" Tag="2000-4000"/>
                                <ComboBoxItem Content="3–6 сек (антиспам)" Tag="3000-6000"/>
                                <ComboBoxItem Content="7–12 сек (осторожно)" Tag="7000-12000"/>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock x:Name="TxtBatchCount" Text="Адресатов: 0 (каждый получит отдельное письмо)"
                                   FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>

                <TextBlock x:Name="LblCc" Grid.Row="2" Grid.Column="0" Text="Копия:" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                <TextBox x:Name="TxtCc" Grid.Row="2" Grid.Column="1" Height="26" VerticalContentAlignment="Center" Padding="4,0" Margin="0,0,0,6"
                         TextChanged="RecipientBox_TextChanged" PreviewKeyDown="RecipientBox_PreviewKeyDown"
                         GotKeyboardFocus="RecipientBox_GotFocus" LostKeyboardFocus="RecipientBox_LostFocus"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Тема:" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                <TextBox x:Name="TxtSubject" Grid.Row="3" Grid.Column="1" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>

                <!-- Автоподсказка адресов -->
                <Popup x:Name="PopupSuggest" StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                    <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderInput}" BorderThickness="1" CornerRadius="5" MinWidth="360" MaxHeight="200">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.22"/>
                        </Border.Effect>
                        <ListBox x:Name="LstSuggest" BorderThickness="0" Background="Transparent" FontSize="12"
                                 PreviewMouseLeftButtonUp="LstSuggest_PreviewMouseLeftButtonUp">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="4,2">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Email}" Foreground="{DynamicResource AccentBrush}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,8">
            <DockPanel>
                <Button DockPanel.Dock="Left" Click="BtnAttach_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconPaperclip}" Stroke="{DynamicResource IconStroke}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Вложение"/>
                    </StackPanel>
                </Button>
                <WrapPanel x:Name="PanelAttachments" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <CheckBox x:Name="ChkSaveOnServer" DockPanel.Dock="Left" Content="Сохранить копию в «Отправленные» на сервере" IsChecked="True" VerticalAlignment="Center" FontSize="12"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,10,0"/>
                <Button x:Name="BtnSend" Style="{StaticResource PrimaryButton}" Click="BtnSend_Click" Margin="0,0,6,0" ToolTip="Отправить письмо (Ctrl+Enter)">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconSend}" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="TxtBtnSend" Text="Отправить (Ctrl+Enter)"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnCancel" Content="Отмена" Click="BtnCancel_Click"/>
            </StackPanel>
        </DockPanel>

        <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6">
            <RichTextBox x:Name="TxtBody" AcceptsReturn="True" AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="10"
                         FontFamily="Segoe UI" FontSize="13"
                         PreviewKeyDown="TxtBody_PreviewKeyDown"
                         ToolTip="Вставка из Excel (Ctrl+V) автоматически оформляется в таблицу. Ctrl+Shift+V — вставить как обычный текст.">
                <RichTextBox.Resources>
                    <Style TargetType="{x:Type Paragraph}">
                        <Setter Property="Margin" Value="0,0,0,4"/>
                    </Style>
                </RichTextBox.Resources>
                <FlowDocument PagePadding="0"/>
            </RichTextBox>
        </Border>
    </DockPanel>
</Window>
